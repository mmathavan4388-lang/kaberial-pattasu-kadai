NODE_ENV=production
PORT=4000
PUBLIC_URL=https://app.example.com
# 32+ random chars: openssl rand -hex 32
JWT_SECRET=
# Postgres (Supabase / RDS / etc). Unset in dev => embedded PGlite.
DATABASE_URL=
# One-time secret to claim First Admin Setup. Remove/rotate after the admin is created.
ADMIN_SETUP_TOKEN=
# Razorpay (UPI/GPay) + Route for split settlement. Secrets stay on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Object storage (any S3-compatible: AWS S3, Supabase Storage, R2). Unset in dev => local ./uploads
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REQUIRE_MOBILE_VERIFICATION=true
